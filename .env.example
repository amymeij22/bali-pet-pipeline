# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Optional database fallback
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# Supabase Storage S3-compatible
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pet_analysis
S3_REGION=ap-southeast-1

# Runtime
# APP_ENV=prod akan menulis artefak ke temporary dir (tidak menyisakan folder pet_analysis di container)
APP_ENV=dev
# Jika false pada APP_ENV=prod, artefak hanya di-upload ke Supabase Storage lalu temporary dir dihapus.
KEEP_LOCAL_ARTIFACTS=true
OUTPUT_PARENT_DIR=reports
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRY_COUNT=3
REQUEST_RETRY_DELAY_SECONDS=2
REQUEST_DELAY_SECONDS=0.5
